# Committed on purpose: throwaway credentials for the e2e database only.
# The e2e suite refuses to run unless DB_NAME ends in _test.
NODE_ENV=test
PORT=3001

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=concert_test

JWT_SECRET=test-secret-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=15m
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
