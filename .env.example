# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose publishes the container on DB_PORT).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=concert

# JWT (HS256). At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Access token lifetime: <number><s|m|h|d>. Defaults to 15m.
JWT_EXPIRES_IN=15m

# Created at startup as the single ADMIN if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
