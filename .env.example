# Copy to .env and adjust. Never commit .env (AGENTS.md §2.12).

# Postgres (booking_db lives here in P0; auth/payment/notif get their own DBs later)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
BOOKING_DB_NAME=booking_db

# Booking service
BOOKING_HTTP_PORT=8080
# Host-side value: use localhost. Inside compose the host is `postgres`.
BOOKING_DATABASE_URL=postgres://postgres:changeme@localhost:5432/booking_db?sslmode=disable
