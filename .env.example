# Copy to .env and adjust. Never commit .env (AGENTS.md §2.12).

# Postgres credentials, shared by both database containers.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# booking_db
POSTGRES_PORT=5432
BOOKING_DB_NAME=booking_db

# auth_db - a separate container, on a separate host port (D2: database per
# service, no shared schemas).
AUTH_POSTGRES_PORT=5433
AUTH_DB_NAME=auth_db

# payment_db - likewise separate. It is the only database in the system that
# holds anything about money (NFR-5.4).
PAYMENT_POSTGRES_PORT=5434
PAYMENT_DB_NAME=payment_db

# --- JWT ---------------------------------------------------------------------
# Shared by Auth (which signs) and the Gateway (which verifies locally, without
# calling Auth - ARCHITECTURE.md §3.3). Both services refuse to start if it is
# shorter than 32 bytes.
#
# Generate a real one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_ISSUER=concert-auth
JWT_AUDIENCE=concert-api

# --- Auth service ------------------------------------------------------------
AUTH_HTTP_PORT=8081
AUTH_GRPC_PORT=9091
# Host-side value, used by `make migrate-up`. Inside compose the host is `auth_db`.
AUTH_DATABASE_URL=postgres://postgres:changeme@localhost:5433/auth_db?sslmode=disable
# Access-token lifetime. This is the upper bound on how long a revoked session
# keeps working, because the gateway validates locally. Optional; defaults to 15m.
AUTH_ACCESS_TTL=15m
# Refresh-token lifetime. Optional; defaults to 168h (7 days).
AUTH_REFRESH_TTL=168h

# First-admin bootstrap. Auth creates this account at startup if - and only if -
# no admin exists yet, which is what makes a fresh `docker compose up` demoable
# without reaching into the database by hand (PRD §7 criterion 5). It is a no-op
# on every subsequent start.
#
# Set both or neither; setting one alone is rejected at startup. The password
# goes through the same rules as any other account, so it must be at least 12
# characters. Change it before this is reachable by anyone but you.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-bootstrap-password

# --- Gateway -----------------------------------------------------------------
GATEWAY_HTTP_PORT=8000
# Per client IP and, separately, per authenticated user; per gateway replica.
# Optional; default 20 rps / burst 40.
GATEWAY_RATE_LIMIT_RPS=20
GATEWAY_RATE_LIMIT_BURST=40
# Deadline on every outbound gRPC call. Optional; defaults to 5s.
GATEWAY_UPSTREAM_TIMEOUT=5s

# --- Redis -------------------------------------------------------------------
# The seat-hold store, and in P3 the lock on the hottest path in the system. No
# password and no persistence locally: everything in it is a hold with a TTL of
# minutes, and Postgres owns every confirmed booking.
REDIS_PORT=6379

# --- Booking service ---------------------------------------------------------
BOOKING_HTTP_PORT=8080
BOOKING_GRPC_PORT=9092
# Container-side only: Booking runs two replicas in compose and publishes no
# host ports, because a fixed one could only ever reach one of them. Everything
# it serves is reachable through the gateway on GATEWAY_HTTP_PORT; for one
# replica directly, `docker compose exec booking wget -qO- localhost:8080/ready`.
# Host-side value, used by `make migrate-up`. Inside compose the host is `postgres`.
BOOKING_DATABASE_URL=postgres://postgres:changeme@localhost:5432/booking_db?sslmode=disable
# The hold store. Inside compose the host is `redis`. Optional; defaults to
# redis:6379. If this is unreachable, Booking REFUSES new holds rather than
# falling back to an unlocked path (D12) - a hold taken without the lock is a
# double-booking waiting for its second customer.
BOOKING_REDIS_ADDR=redis:6379
# Checkout window (PRD §4.1), and literally the EX on the Redis key. An
# abandoned checkout expires on Redis's clock with no sweeper, no ticker and no
# replica having to be the one that owns it. Optional; defaults to 10m.
BOOKING_HOLD_TTL=10m

# --- Payment service ---------------------------------------------------------
PAYMENT_HTTP_PORT=8082
PAYMENT_GRPC_PORT=9093
# Host-side value, used by `make migrate-up`. Inside compose the host is `payment_db`.
PAYMENT_DATABASE_URL=postgres://postgres:changeme@localhost:5434/payment_db?sslmode=disable
# How the mock provider answers: succeed | decline | hang. Real money is out of
# scope (ARCHITECTURE.md §7); this is what makes the saga's compensation paths
# demonstrable in a running stack rather than only in tests.
#
#   succeed  the happy path
#   decline  seats are released and the reservation fails (ARCHITECTURE.md §6.2 row 1)
#   hang     the outcome is UNKNOWN: seats stay held and the reconciliation job
#            resolves them, which is decision D8 in action. Their Redis hold is
#            pushed out rather than left to expire, so this is also how you check
#            that guard is still there
PAYMENT_PROVIDER_MODE=succeed
# Simulated provider latency. Optional; defaults to 0s.
PAYMENT_PROVIDER_LATENCY=0s
# Deadline on one provider call. Exceeding it is an UNKNOWN outcome, never a
# failed one. It is per attempt: PAYMENT_PROVIDER_MAX_ATTEMPTS of these, plus
# the backoff between them, must fit inside BOOKING_PAYMENT_TIMEOUT or the retry
# never runs. Optional; defaults to 1s.
PAYMENT_PROVIDER_TIMEOUT=1s
# Bounded retries (FR-4.4). Safe only because the idempotency key is passed
# through to the provider. Optional; defaults to 2.
PAYMENT_PROVIDER_MAX_ATTEMPTS=2

# --- Booking -> Payment ------------------------------------------------------
# Deadline on the call to Payment. Exceeding it leaves the reservation pending
# for reconciliation; it never releases seats (D8).
#
# Keep it comfortably under GATEWAY_UPSTREAM_TIMEOUT. Deadlines have to nest: if
# the gateway gives up first the customer gets a 504 instead of the 202 that
# says their payment is still settling. Optional; defaults to 3s.
BOOKING_PAYMENT_TIMEOUT=3s
# Circuit breaker on the Booking -> Payment dependency (ARCHITECTURE.md §10):
# consecutive failures before it opens, and how long before it probes again.
# Optional; defaults to 5 and 30s.
BOOKING_BREAKER_THRESHOLD=5
BOOKING_BREAKER_COOLDOWN=30s
# The reconciliation job (ARCHITECTURE.md §6.3). It owns every reservation whose
# payment outcome is unknown, and in P3 owning one also means pushing its Redis
# hold out on every pass - otherwise the TTL puts those seats back on sale under
# a charge that may have succeeded (D8). The interval must therefore stay well
# inside BOOKING_HOLD_TTL. The grace period must exceed BOOKING_PAYMENT_TIMEOUT:
# it is also how long the job waits after releasing on a "no charge" answer
# before asking again, and a charge started just before that release takes up
# to one payment call to land. Booking refuses to start if either is not so.
# Optional; defaults to 15s and 30s.
BOOKING_RECONCILE_INTERVAL=15s
BOOKING_RECONCILE_GRACE=30s
