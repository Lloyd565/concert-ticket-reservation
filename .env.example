# Copy to .env and adjust. Never commit .env (AGENTS.md §2.12).

# Postgres credentials, shared by both database containers.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# booking_db
POSTGRES_PORT=5432
BOOKING_DB_NAME=booking_db

# auth_db - a separate container, on a separate host port (D2: database per
# service, no shared schemas).
AUTH_POSTGRES_PORT=5433
AUTH_DB_NAME=auth_db

# --- JWT ---------------------------------------------------------------------
# Shared by Auth (which signs) and the Gateway (which verifies locally, without
# calling Auth - ARCHITECTURE.md §3.3). Both services refuse to start if it is
# shorter than 32 bytes.
#
# Generate a real one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_ISSUER=concert-auth
JWT_AUDIENCE=concert-api

# --- Auth service ------------------------------------------------------------
AUTH_HTTP_PORT=8081
AUTH_GRPC_PORT=9091
# Host-side value, used by `make migrate-up`. Inside compose the host is `auth_db`.
AUTH_DATABASE_URL=postgres://postgres:changeme@localhost:5433/auth_db?sslmode=disable
# Access-token lifetime. This is the upper bound on how long a revoked session
# keeps working, because the gateway validates locally. Optional; defaults to 15m.
AUTH_ACCESS_TTL=15m
# Refresh-token lifetime. Optional; defaults to 168h (7 days).
AUTH_REFRESH_TTL=168h

# First-admin bootstrap. Auth creates this account at startup if - and only if -
# no admin exists yet, which is what makes a fresh `docker compose up` demoable
# without reaching into the database by hand (PRD §7 criterion 5). It is a no-op
# on every subsequent start.
#
# Set both or neither; setting one alone is rejected at startup. The password
# goes through the same rules as any other account, so it must be at least 12
# characters. Change it before this is reachable by anyone but you.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-bootstrap-password

# --- Gateway -----------------------------------------------------------------
GATEWAY_HTTP_PORT=8000
# Per client IP, per gateway replica. Optional; default 20 rps / burst 40.
GATEWAY_RATE_LIMIT_RPS=20
GATEWAY_RATE_LIMIT_BURST=40
# Deadline on every outbound gRPC call. Optional; defaults to 5s.
GATEWAY_UPSTREAM_TIMEOUT=5s

# --- Booking service ---------------------------------------------------------
BOOKING_HTTP_PORT=8080
BOOKING_GRPC_PORT=9092
# Host-side value, used by `make migrate-up`. Inside compose the host is `postgres`.
BOOKING_DATABASE_URL=postgres://postgres:changeme@localhost:5432/booking_db?sslmode=disable
# Checkout window (PRD §4.1). Optional; defaults to 10m.
BOOKING_HOLD_TTL=10m
# How often expired holds are swept. Optional; defaults to 5s. This is the
# accuracy limit of P0 expiry - Redis TTLs remove it in P3.
BOOKING_SWEEP_INTERVAL=5s
